# ==============================================================================
# VidyaPath AI - Environment Configuration
# ==============================================================================

# Supabase Configuration
# Required for live Supabase Auth, PostgreSQL, and Row Level Security
# The application automatically falls back to offline/mock mode if left empty
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Provider Configuration
# Choose one of the following providers (or leave blank to use mock intelligent assistant)
# Options: 'openrouter' | 'openai' | 'gemini' | 'mock'
VITE_AI_PROVIDER=mock
VITE_OPENROUTER_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_AI_MODEL=

# Application & Telemetry
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000

# Transactional Email (Optional / Server-side)
RESEND_API_KEY=
