# ==============================================================================
# VidyaPath AI - Environment Configuration
# ==============================================================================

# Supabase Live Backend Configuration
# 1. Sign in to https://supabase.com/dashboard/project/<your-project-id>
# 2. Go to Project Settings -> API
# 3. Copy the "Project URL" into VITE_SUPABASE_URL
# 4. Copy the "anon" public key into VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Provider Configuration
# Options: 'openrouter' | 'openai' | 'gemini' | 'mock'
VITE_AI_PROVIDER=mock
VITE_OPENROUTER_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_AI_MODEL=

# Admin Authentication Secret
VITE_ADMIN_SECRET=vidyapath-admin-2026

# Application Environment
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000
